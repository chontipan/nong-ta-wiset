rules_version = '2';

// Security rules for the waste-5b576 Firestore database.
// The app has no login, so these rules can't tell users apart. They limit
// what can be written: only the expected fields, with sane types and sizes,
// and scan history can't be edited or deleted after it is written.
service cloud.firestore {
  match /databases/{database}/documents {

    function isShortString(v, max) {
      return v is string && v.size() <= max;
    }

    function isDayId(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validBin(v) {
      return v in ['plastic_bottle', 'recyclable', 'general', 'hazardous', 'money', 'organic'];
    }

    // Scan history: anyone can read and add, nobody can change or delete
    match /scans/{scanId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['item', 'bin', 'type', 'confidence', 'timestamp', 'timeString', 'day', 'kiosk'])
                    && isShortString(request.resource.data.item, 200)
                    && isShortString(request.resource.data.bin, 60)
                    && validBin(request.resource.data.type)
                    && isShortString(request.resource.data.confidence, 8)
                    && isShortString(request.resource.data.timeString, 20)
                    && request.resource.data.timestamp == request.time
                    && (!('day' in request.resource.data) || isDayId(request.resource.data.day))
                    && (!('kiosk' in request.resource.data) || isShortString(request.resource.data.kiosk, 40));
      allow update, delete: if false;
    }

    // Daily counters: stats/2026-10-30 (all kiosks) and stats/2026-10-30__<kiosk> (one kiosk).
    // Only the known number fields, each can only go up by a small step.
    // The old cumulative 'today' doc stays readable but is no longer written.
    match /stats/{docId} {
      allow read: if true;
      allow create, update: if docId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}(__[^/]{1,40})?$')
                    && request.resource.data.keys().hasOnly(
                         ['total', 'plastic_bottle', 'recyclable', 'general', 'hazardous', 'co2', 'lastUpdated', 'day', 'kiosk'])
                    && request.resource.data.lastUpdated == request.time
                    && request.resource.data.day == docId.split('__')[0]
                    && (!('kiosk' in request.resource.data) || docId == request.resource.data.day + '__' + request.resource.data.kiosk)
                    && smallIncrease('total', 1)
                    && smallIncrease('plastic_bottle', 1)
                    && smallIncrease('recyclable', 1)
                    && smallIncrease('general', 1)
                    && smallIncrease('hazardous', 1)
                    && smallIncrease('co2', 0.2);
      allow delete: if false;

      function oldValue(field) {
        return resource == null ? 0 : resource.data.get(field, 0);
      }
      function smallIncrease(field, maxStep) {
        return !(field in request.resource.data)
            || (request.resource.data[field] is number
                && request.resource.data[field] >= oldValue(field)
                && request.resource.data[field] - oldValue(field) <= maxStep);
      }
    }

    // Trained Thai products: anyone can read and add. Nobody can delete or rewrite one:
    // the app's delete button only hides it (hidden + hiddenAt), so it can be restored. Reference photos are capped at ~200KB, up to 5 photos.
    match /custom_thai_products/{productId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['id', 'name', 'bin', 'binName', 'shape', 'price', 'estValue', 'advice', 'image', 'images', 'timestamp'])
                    && request.resource.data.id == productId
                    && isShortString(request.resource.data.name, 100)
                    && validBin(request.resource.data.bin)
                    && isShortString(request.resource.data.shape, 40)
                    && (!('binName' in request.resource.data) || isShortString(request.resource.data.binName, 60))
                    && (!('price' in request.resource.data) || isShortString(request.resource.data.price, 100))
                    && (!('estValue' in request.resource.data) || request.resource.data.estValue is number)
                    && (!('advice' in request.resource.data) || isShortString(request.resource.data.advice, 500))
                    && (!('image' in request.resource.data) || request.resource.data.image == null
                        || isShortString(request.resource.data.image, 200000))
                    // Extra photos from different angles (the 1MB document limit caps their total size)
                    && (!('images' in request.resource.data)
                        || (request.resource.data.images is list && request.resource.data.images.size() <= 5))
                    && (!('timestamp' in request.resource.data) || isShortString(request.resource.data.timestamp, 40));
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'hiddenAt'])
                    && request.resource.data.hidden is bool
                    && request.resource.data.hiddenAt == request.time;
      allow delete: if false;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
